[Desktop Entry]
Type=Application
Name=MeeTranslate
Comment=Translator
Exec=invoker --type=e --single-instance /usr/bin/python /opt/meetranslate/main.py
Icon=/usr/share/icons/hicolor/80x80/apps/meetranslate80.png
X-Window-Icon=
X-HildonDesk-ShowInToolbar=true
X-Osso-Type=application/x-executable
Categories=Utility;
